<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>NeverOutOfPrint.PickleSteps</AssemblyName>
    <RootNamespace>NeverOutOfPrint.PickleSteps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\Mod\Pickle\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- No publicizer: this suite touches only public game API, and the two private-field reads in
         Steps.cs (BookOutcomeDoer_Ideoligion.ideoligion) go through reflection on purpose, into this
         mod's own shipped code, not the game's. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.Pickle.Ref" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The mod under test, for BookOutcomeDoer_Ideoligion and CompCopiedBook. Private=false: the
         game loads the real one, and a copy under Pickle/Assemblies would be a second
         NeverOutOfPrint.dll fighting the first over the same defNames/types. -->
    <Reference Include="NeverOutOfPrint">
      <HintPath>..\..\..\Mod\Assemblies\NeverOutOfPrint.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
